{
  "name": "keepwell-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST do KeepWell.",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "db:setup": "node --env-file=.env src/scripts/setup-database.js",
    "test": "node --test",
    "test:integration": "node --env-file=.env src/scripts/check-registration.js",
    "test:auth": "node --env-file=.env src/scripts/check-authentication.js",
    "admin:promote": "node --env-file=.env src/scripts/promote-admin.js",
    "test:categories": "node --env-file=.env src/scripts/check-category-admin.js",
    "test:objects": "node --env-file=.env src/scripts/check-objects.js",
    "seed:demo": "node --env-file=.env src/scripts/seed-demo.js",
    "test:photos": "node --env-file=.env src/scripts/check-photos.js",
    "test:tasks": "node --env-file=.env src/scripts/check-tasks.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "mongodb": "^7.8.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5"
  }
}
